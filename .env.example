# DoCA Backend Environment Configuration

PROJECT_NAME="DoCA Legal Metrology Compliance System"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_super_secret_key_generate_using_openssl_rand_hex_32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=doca_admin
POSTGRES_PASSWORD=doca_secure_password_2026
POSTGRES_DB=doca_db
DATABASE_URL="postgresql+asyncpg://doca_admin:doca_secure_password_2026@localhost:5432/doca_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="minio_secure_password_2026"
MINIO_BUCKET_EVIDENCE="doca-evidence"
MINIO_BUCKET_REPORTS="doca-reports"
MINIO_SECURE=False

# Active Rule Set Baseline
ACTIVE_RULE_SET_VERSION="LM-PCR-2011-v1.0"

# CORS (comma-separated — web + Expo RN)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,exp://192.168.1.2:8081"

# Storage backend: local | supabase
STORAGE_BACKEND="local"
MAX_UPLOAD_MB=10

# Supabase (Postgres + Storage only — paste from Supabase dashboard, see SUPABASE_SETUP.md)
# DATABASE_URL uses the POOLER (port 6543) + ssl=require, e.g.:
# DATABASE_URL="postgresql+asyncpg://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET_EVIDENCE=""
SUPABASE_BUCKET_REPORTS=""
SUPABASE_URL_EXPIRE_SECS=3600

# Refresh tokens (RN long sessions)
REFRESH_TOKEN_EXPIRE_DAYS=30
